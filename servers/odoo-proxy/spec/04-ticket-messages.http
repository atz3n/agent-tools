# Odoo Proxy — Ticket Messages
# Fetches thread messages for a given task.
# Replace thread_id with your task ID.

POST my.odoo.url/mail/thread/messages HTTP/1.1
Cookie: session_id=session_id_from_step_2
Content-Type: application/json
Host: my.odoo.url

{
  "id": 21,
  "jsonrpc": "2.0",
  "method": "call",
  "params": {
    "thread_id": 123,
    "thread_model": "project.task",
    "limit": 30
  }
}

