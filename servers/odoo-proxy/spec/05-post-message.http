# Odoo Proxy — Post Message
# Posts a note to a ticket thread via /mail/message_post RPC endpoint.
# Replace thread_id and body with your values.

POST my.odoo.url/mail/message/post HTTP/1.1
Cookie: session_id=session_id_from_step_2
Content-Type: application/json
Host: my.odoo.url

{
  "id": 42,
  "jsonrpc": "2.0",
  "method": "call",
  "params": {
    "context": {
      "lang": "en_GB",
      "tz": "Europe/Berlin",
      "uid": 25,
      "allowed_company_ids": [
        1
      ],
      "mail_post_autofollow": false,
      "temporary_id": 0.01
    },
    "post_data": {
      "body": "Your message body here",
      "attachment_ids": [],
      "attachment_tokens": [],
      "canned_response_ids": [],
      "message_type": "comment",
      "partner_ids": [],
      "subtype_xmlid": "mail.mt_note",
      "partner_emails": [],
      "partner_additional_values": {}
    },
    "thread_id": 123,
    "thread_model": "project.task"
  }
}

### Response
# HTTP/1.1 200 OK
# Date: Thu, 23 Jul 2026 14:05:14 GMT
# Content-Type: application/json; charset=utf-8
# Transfer-Encoding: chunked
# Connection: close
# X-Content-Type-Options: nosniff, nosniff
# Server: Odoo.sh
# Content-Encoding: gzip

